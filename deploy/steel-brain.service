[Unit]
Description=Steel Brain API
After=network.target

[Service]
# TODO (future hardening): runs as root today; move to a dedicated non-root
# `steelbrain` user + /opt/steel-brain once the service is stable.
Type=simple
User=root
WorkingDirectory=/root/steel-brain
Environment=SB_DB=/root/steel-brain/shell.db
ExecStart=/root/steel-brain/venv/bin/uvicorn steel_brain.http_api:app --host 0.0.0.0 --port 8080 --app-dir /root/steel-brain/src
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
